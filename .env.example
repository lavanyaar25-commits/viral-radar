# Copy this file to ".env" for local runs. Never commit ".env".
# EVERY key here is OPTIONAL. The pipeline runs with none of them.

# Optional. Reddit blocks data-centre traffic, which is what GitHub Actions is.
# Without these you still get Reddit on your laptop, but not from the cloud.
# Free, takes 3 minutes: https://www.reddit.com/prefs/apps -> create app -> "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional. Writes the plain-English "why this matters" and "what to do" lines.
# Roughly 30 cents a month. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Your GitHub Pages URL, used in the sitemap.
SITE_URL=https://YOURNAME.github.io/viral-radar
